# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kupas

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Book Catalog API
CATALOG_API_URL=https://api.buku.cloudapp.web.id/getPenggerakTextBooks
DETAIL_API_URL=https://api.buku.cloudapp.web.id/getDetails

# PDF Storage
PDF_STORAGE_DIR=kupas/storage/pdf

# Admin Panel (admin.kupas.id — run on port 8001)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme_please
ENV_FILE_PATH=.env
