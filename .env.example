# Database
# For local development (PostgreSQL running on your machine):
DATABASE_URL=postgresql+asyncpg://kupas_user:changeme_please@localhost:5432/kupas
# For Docker Compose (uses the bundled postgres service):
# DATABASE_URL=postgresql+asyncpg://kupas_user:changeme_please@postgres:5432/kupas

# PostgreSQL service credentials (used by docker-compose.yml)
POSTGRES_USER=kupas_user
POSTGRES_PASSWORD=changeme_please
POSTGRES_DB=kupas

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Book Catalog API
CATALOG_API_URL=https://api.buku.cloudapp.web.id/getPenggerakTextBooks
DETAIL_API_URL=https://api.buku.cloudapp.web.id/getDetails

# PDF Storage
PDF_STORAGE_DIR=kupas/storage/pdf

# Admin Panel (admin.kupas.id — run on port 8001)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme_please
# Comma-separated list of origins allowed to access the Admin JSON API via CORS.
# Leave empty to block all cross-origin requests.
ADMIN_CORS_ORIGINS=
ENV_FILE_PATH=.env
